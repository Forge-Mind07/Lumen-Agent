# OpenAI-compatible model endpoint. The server must support tool calling.
PRIMARY_MODEL_BASE_URL=http://127.0.0.1:8080/v1
PRIMARY_MODEL_NAME=your-local-model-id
PRIMARY_MODEL_API_KEY=local-placeholder

# Optional secondary endpoint.
# SECONDARY_MODEL_BASE_URL=http://127.0.0.1:8002/v1
# SECONDARY_MODEL_NAME=your-secondary-model-id
# SECONDARY_MODEL_API_KEY=local-placeholder

TEMPERATURE=0.1
MAX_TOKENS=8192
MODEL_TIMEOUT_SECONDS=600
STREAM_IDLE_TIMEOUT_SECONDS=120
CONTEXT_LIMIT_TOKENS=65536
QUERY_TIMEOUT_SECONDS=30
QUERY_ROW_LIMIT=200
MAX_TOOL_CALLS=10
MAX_ANALYSIS_ITERATIONS=8
DATA_DIR=../data
DEBUG=false

# Optional: enables Research Chat web tools.
# TAVILY_API_KEY=your_key_here
WEB_SEARCH_TIMEOUT_SECONDS=25
WEB_SEARCH_MAX_RESULTS=6

# Bounded local ML runtime.
ML_MAX_ROWS=20000
ML_MAX_COLUMNS=80
ML_TIMEOUT_SECONDS=180
ML_MAX_CANDIDATES=3
ML_MAX_SNAPSHOT_BYTES=50000000
